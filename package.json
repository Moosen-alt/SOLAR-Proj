{
  "name": "solar-submission-autopilot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx backend/src/server.ts",
    "start": "tsx backend/src/server.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit",
    "smoke": "tsx backend/src/smoke.ts",
    "portal:login": "tsx portal-bot/src/testRun.ts login",
    "portal:test": "tsx portal-bot/src/testRun.ts",
    "portal:test:unit": "tsx portal-bot/src/adapters/recipeAdapter.test.ts && tsx portal-bot/src/adapters/autoLearnAdapter.test.ts",
    "portal:test:learn": "tsx portal-bot/src/adapters/autoLearnAdapter.test.ts",
    "portal:record": "tsx portal-bot/src/recordRecipe.ts",
    "portal:install": "playwright install chromium"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.105.0",
    "@napi-rs/canvas": "^1.0.0",
    "@types/adm-zip": "^0.5.8",
    "adm-zip": "^0.5.17",
    "better-sqlite3": "^12.11.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "imapflow": "^1.4.2",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.0.227",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.7",
    "playwright": "^1.61.0",
    "typescript": "^5.7.3"
  }
}
