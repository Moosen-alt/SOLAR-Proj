# =============================================================================
# Solar Submission Autopilot — environment configuration
# -----------------------------------------------------------------------------
# Copy this file to ".env" and fill in the values. ".env" is gitignored, so
# secrets you put there are never committed. Every variable the app actually
# reads is listed below; anything left blank falls back to the default shown.
# =============================================================================

# ---- Core server ----------------------------------------------------------
# HTTP port the dashboard + API listen on.
PORT=4173

# Path to the SQLite database file (created automatically on first run).
AUTOPILOT_DB_PATH=backend/data/autopilot.sqlite

# ---- Secrets --------------------------------------------------------------
# Encrypts stored portal storage-state blobs (Playwright login sessions).
# Use a long random string. Generate one with:  openssl rand -hex 32
SESSION_ENCRYPTION_KEY=replace-with-a-long-random-secret

# ---- LLM (advisory only) --------------------------------------------------
# Anthropic API key. If unset, the app runs in "stub" mode: it still works,
# but LLM steps return advisory placeholders and flag for human review.
# The model is fixed in code to claude-opus-4-8.
ANTHROPIC_API_KEY=

# ---- Authentication (optional, OFF by default) ----------------------------
# Set AUTH_ENABLED=true to require login on the dashboard. When you turn it on,
# also set ADMIN_EMAIL + ADMIN_PASSWORD so the first login is seeded on boot.
# PRODUCTION (internet-facing) — REQUIRED before go-live:
#   AUTH_ENABLED=true, ADMIN_EMAIL/ADMIN_PASSWORD set, AUTH_COOKIE_SECURE=true,
#   served behind HTTPS. Login is rate-limited (lockout after repeated failures).
AUTH_ENABLED=false
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Secret used to sign session cookies. If blank, falls back to
# SESSION_ENCRYPTION_KEY, then to an ephemeral key (sessions reset on restart).
AUTH_SECRET=
# How long a login stays valid, in hours.
AUTH_SESSION_HOURS=12
# Set to true only when serving over HTTPS (marks the session cookie Secure).
AUTH_COOKIE_SECURE=false
# Comma-separated list of allowed browser origins for CORS. Leave blank for a
# same-origin SPA (reflects any origin). For internet-facing deploys, set this
# to your dashboard URL(s), e.g. https://solar.example.com
ALLOWED_ORIGINS=

# ---- Automated database backups -------------------------------------------
# Snapshots are written on startup and then on the interval below.
BACKUP_DIR=backend/data/backups
BACKUP_KEEP=14
BACKUP_INTERVAL_HOURS=24
# Production: 1-4 h, and BACKUP_KEEP = 168 / interval for 7 days (2 h -> 84). docs/OPERATIONS.md s5.
# OFF-BOX copy: a cloud-synced folder or network share. Each snapshot is copied there hash-verified
# (the server does the snapshot; scripts/ops/offbox-sync.ts also mirrors the documents).
# BACKUP_SECOND_DIR=C:\Users\you\OneDrive\SolarBackups
# BACKUP_SECOND_KEEP=24
# SESSION_ENCRYPTION_KEY is in NO backup: escrow it in a password manager (OPERATIONS.md s5.3).

# ---- Watchdog (scripts/ops/watchdog.ts; install with scripts/ops/install-watchdog.ps1) ----
# Email uses the SMTP_* settings below. Never sends customer names or addresses.
# WATCHDOG_ALERT_TO=you@yourcompany.com
# WATCHDOG_WEBHOOK_URL=https://ntfy.sh/<long-random-topic>
# WATCHDOG_WEBHOOK_FORMAT=text
# WATCHDOG_HEARTBEAT_URL=https://hc-ping.com/<uuid>   # alerts you when this whole machine goes silent
# WATCHDOG_INTERVAL_SECONDS=300

# ---- Automated monitors (hands-off ops) -----------------------------------
# How often the permit/NEM status checks + email tracker run automatically.
# Set to 0 to disable and run them manually via the endpoints instead.
MONITOR_INTERVAL_MINUTES=15

# ---- Test fixtures ---------------------------------------------------------
# DEV ONLY: seeds the TML INTERNATIONAL LLC test installer on first run so flows
# can be exercised end-to-end. OFF by default — production databases start empty
# and onboard real installers through the Clients UI. Uncomment for a dev box.
# SEED_TEST_INSTALLER=true

# ---- Background job worker -------------------------------------------------
# How often (ms) the worker polls for queued jobs.
JOB_WORKER_INTERVAL_MS=5000

# ---- Logging / debugging --------------------------------------------------
# LOG_LEVEL: error | warn | info | debug  (default info). Or set DEBUG=true.
# Every request logs one line: "<time> ICON LEVEL [http] <status> <method> <path> ms=Nms".
# 5xx errors print a boxed, copy-pasteable block. GET /api/diagnostics returns a
# full JSON snapshot (config, data counts, warnings) — paste it when troubleshooting.
LOG_LEVEL=info
# DEBUG=true

# ---- Client notifications (optional, outbound email) ------------------------
# When a monitored permit/NEM status CHANGES (issued, ready-for-issue, NEM
# approved, correction), the submitting client gets a plain-language email with
# the new status + their tokenized read-only status page link (/status?token=…,
# no login; address + status labels only — never account/meter numbers).
# Without SMTP settings the update is still recorded as a DRAFT communication in
# the CRM timeline (copy/send by hand). Set CLIENT_NOTIFICATIONS=0 to disable
# even the drafts. PUBLIC_BASE_URL is the externally reachable URL used in the
# emailed status links.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Permits <permits@yourcompany.com>"
# SMTP_SECURE=false
# CLIENT_NOTIFICATIONS=1
# PUBLIC_BASE_URL=https://solar.example.com

# ---- Gmail integration (optional) -----------------------------------------
# Only needed if you connect a Gmail account for correspondence tracking.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=
GMAIL_REFRESH_TOKEN=

# ---- IMAP polling (optional) -----------------------------------------------
# For corporate / Exchange / self-hosted inboxes (non-Gmail). When EMAIL_IMAP_HOST
# is set, the monitor scheduler polls the inbox every MONITOR_INTERVAL_MINUTES
# and runs new messages through the email tracker / correction-bucket pipeline.
# Passwords are read from environment only — never stored or logged.
EMAIL_IMAP_HOST=
EMAIL_IMAP_PORT=993
EMAIL_IMAP_USER=
EMAIL_IMAP_PASS=
# Set to false to use STARTTLS instead of IMAPS.
EMAIL_IMAP_TLS=true
# Which mailbox to poll. Defaults to INBOX.
EMAIL_IMAP_MAILBOX=INBOX
# Max messages to fetch per poll cycle (newest N). Default 100.
EMAIL_IMAP_MAX_MESSAGES=100

# ---- Mailbox / email import limits (optional) -----------------------------
# Browser-upload cap for the "Import MBOX" button. For LARGE .mbox files
# (multi-GB Gmail/Outlook exports), don't use the button — paste the file's
# full local path and click "Import Path", which streams from disk with NO
# size cap. These limits only apply to the in-browser upload route.
MBOX_IMPORT_LIMIT=1gb
MBOX_IMPORT_MAX_BYTES=1073741824
EMAIL_TRACKER_MAX_BYTES=1073741824

# ---- Batch zip import (optional) ------------------------------------------
# Max size for an uploaded .zip of past-project PDFs (drag-and-drop). Raise if
# your zip is bigger. Accepts sizes like "2gb".
BATCH_ZIP_LIMIT=2gb

# Where batch "Learn from Past Projects" scan reports are written (JSON + TXT).
# Defaults to backend/data/batch-reports. Each scan also prints a summary to the
# terminal so you can troubleshoot what was and wasn't learned.
BATCH_REPORT_DIR=backend/data/batch-reports

# Permit valuation — per-watt fallback rate ($/W DC) used to estimate project
# valuation when the client hasn't provided the actual contract / installed cost.
# Default 3.00. The estimate is flagged in the reviewer gate and can be overridden
# by the client via the intake link.
PERMIT_VALUATION_PER_WATT=3.00

# ---- Portal automation ----------------------------------------------------
# Set to "false" locally to see the Chromium window during portal recording/learning.
# Set to "true" (or leave unset) in production — no display available on a server.
PORTAL_HEADLESS=false

# UNIVERSAL SELF-SEED (default ON). When a project is staged against a real portal that has
# no recorded recipe yet, the universal learner runs automatically during staging: it records a
# recipe AND stages the project to review in one pass, auto-promoting the recipe to "complete"
# only when its triple-verification passes cleanly — so the NEXT stage replays it deterministically.
# The learner never clicks final submit, never pays a fee, never solves a CAPTCHA, and bails to a
# human on MFA/CAPTCHA. On a learn failure, staging STOPS and surfaces the reason (no silent
# fallback to the hand-coded adapter). Set PORTAL_AUTOSEED=0 to disable self-seed and revert to
# the legacy hand-coded PowerClerk/Accela fallback when no recipe exists.
# Default is ON; set it explicitly so a stray "0" can't silently disable universal + PGE learning.
PORTAL_AUTOSEED=1

# Review-screen PII at rest: the auto-learner writes the captured review-page screenshot to
# data/screenshots so the dashboard can show it. A portal-rendered review can display account/meter
# numbers as plain text, so that PNG may contain customer PII on disk. Set PORTAL_SAVE_REVIEW_SCREENSHOT=0
# to skip the disk write (the in-memory vision verification is separately controlled by
# PORTAL_VISION_VERIFY=0). Default on.
# PORTAL_SAVE_REVIEW_SCREENSHOT=1

# Vision-assisted PLANNING (learn-time): the universal learner attaches a screenshot of each page
# to the planner so it reads the visible section headings/layout — the authoritative signal for
# which contact block is the customer vs the installer, and what custom widgets are. This is what
# lets it route homeowner/installer data correctly without portal-specific rules. It runs ONLY
# during the one-time learn pass (replay stays text-free), so the extra image cost is amortized.
# Set PORTAL_VISION_PLAN=0 to disable (falls back to text + the field "section" hint). Default on.
# PORTAL_VISION_PLAN=1

# Replay self-test (learn-time, OPT-IN). After a learn pass that would be trusted, re-run the
# just-learned recipe deterministically via the RecipeAdapter in a fresh session and require it to
# reach the review screen before the recipe is promoted to "complete" — proof that the recorded
# SELECTORS replay, not just that the live fill worked. WARNING: this drives the LIVE portal a second
# time, which can create a SECOND draft application, so it is OFF by default. Enable it to validate a
# freshly-learned recipe. On non-reproduction or error the recipe is kept as a draft.
# PORTAL_REPLAY_SELFTEST=0

# Deterministic policy answers during learning. On UTILITY interconnection learns the bot
# force-answers two standard-residential-NEM policy questions the planner sometimes leaves
# blank or gets wrong: "limit export capacity?" → No and "inverters UL 1741 lab certified?"
# → Yes. These are scoped to utility learns only (AHJ/permit portals never get them). Set
# PORTAL_POLICY_DEFAULTS=off for non-standard projects (export-limited systems, non-listed
# equipment) so the planner + project data decide instead.
# PORTAL_POLICY_DEFAULTS=on

# ---- Auto-learn debug bundle (ON by default) --------------------------------
# EVERY learn run writes a complete forensic bundle to data/learn-runs/<runId>/ so a
# failed run is never un-diagnosable and troubleshooting never needs a blind re-run:
#   run.json       — manifest: portal, config snapshot, outcome, duration, final message
#   events.jsonl   — timeline: login, per-page trace, recovery attempts, validation blocks
#   pNNN-plan.json — per page: fields the bot SAW + the planner's fill decisions (masked)
#   pNNN-rescan.json — conditional fields revealed after a dropdown/selection
#   pNNN-before/after-*.png — full-page screenshots around each page's fills
#   trace.zip      — Playwright trace (DOM snapshots+actions+network), started AFTER login
#                    so credentials never enter it; open at https://trace.playwright.dev
#   llm-calls.json — every Claude call's latency/tokens/cache-hits/stop_reason (no prompts)
#   verdict.json   — text/vision/deterministic verification signals + trust-gate decision
#   result.json / review.png — the final outcome + captured review screenshot
# List runs: GET /api/learn-runs. Download one to send for troubleshooting:
#   GET /api/learn-runs/<runId>/bundle.zip   (or /api/learn-runs/latest/bundle.zip)
# PII note: JSON artifacts mask sensitive values, but the PNGs and Playwright trace are
# RAW portal renders and can show customer data — same class as the review screenshot.
# Bundles stay on local disk (data/ is gitignored) and only the newest AUTOLEARN_RUN_KEEP
# are retained.
# AUTOLEARN_RUN_DEBUG=1         # set 0 to disable the bundle entirely
# AUTOLEARN_RUN_KEEP=20         # how many run folders to keep
# AUTOLEARN_DEBUG_SCREENSHOTS=1 # set 0 to skip the per-page PNGs (JSON still written)
# AUTOLEARN_TRACE=1             # set 0 to skip the Playwright trace
# AUTOLEARN_RUN_DIR=            # override the bundle folder (default data/learn-runs)

# Verbose learn-loop console output: page traces, LLM planner calls, recovery attempts.
# Leave off unless actively debugging a stuck run (the bundle above captures the same
# detail on disk for every run regardless).
# AUTOLEARN_DEBUG=1

# Post-navigation dwell (ms) after a page load settles, before the next scrape. Raise this
# if a slow client-rendered portal page is still hydrating its form fields when the bot
# scrapes (fields come back missing/blank). Default 1100.
# AUTOLEARN_NAV_DWELL_MS=1100

# Section render-readiness budget (ms): how long an adapter waits for a Vue/React/ExtJS
# wizard section to mount an interactive control before filling it — guards against the
# blank-draft race where a fill fires on a visible-but-unbound input. Used by both the
# universal recipe replay and the hand-coded PowerClerk adapter. The legacy
# POWERCLERK_SECTION_READY_MS is still honored as a fallback for existing tuning.
# Default 12000.
# PORTAL_SECTION_READY_MS=12000

# Comma-separated hostnames/IPs to bypass the egress proxy (HTTPS_PROXY) for.
# 127.0.0.1, localhost, and ::1 are always bypassed automatically.
# Add your office VPN subnet or internal portal hostnames here if needed.
# PORTAL_PROXY_BYPASS=10.0.0.0/8,192.168.1.100

# ---- Litestream (optional — continuous SQLite backup to S3/R2/Backblaze) --
# Leave blank to skip Litestream. Configure all four to enable.
# Cloudflare R2 has zero egress fees and a free tier — recommended.
# R2 endpoint format: https://<account_id>.r2.cloudflarestorage.com
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
LITESTREAM_BUCKET=solar-autopilot-db
LITESTREAM_BUCKET_REGION=auto
LITESTREAM_BUCKET_ENDPOINT=

# ---- Review gate (sellable standalone tool) ---------------------------------
# The plan-review gate at /review (POST /api/review): deterministic solar checks
# + AI-assisted pre-review for general building plans, against per-jurisdiction
# adopted-code profiles (research → human verify onboarding). Multi-tenant:
# create review_gate orgs + API keys via /api/orgs (admin). Per-org daily review
# quota (LLM cost guard); 0 disables.
# REVIEW_DAILY_LIMIT=200

# Local isolated review: bind loopback and disable all background workers.
# SERVER_HOST=127.0.0.1
# BACKGROUND_WORKERS=off
# AHJ_FORM_RESEARCH=off
# Container reference files are outside the writable DB volume.
# AHJ_PROCESS_REFERENCE_PATH=/app/reference/reference-ahj-processes.json
# CODE_PROFILE_REFERENCE_PATH=/app/reference/reference-code-profiles.json
# Set off to disable even free downloads from known official form URLs.
# AHJ_FORM_DOWNLOADS=off
