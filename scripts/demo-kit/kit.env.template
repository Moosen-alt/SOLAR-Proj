# ---------------------------------------------------------------------------
# PORTABLE DEMO KIT — this environment is deliberately powerless.
#
# There are NO credentials in this file, and that is the point. This kit carries
# four synthetic projects for a fake company and nothing else; it cannot reach a
# utility portal, cannot send mail, cannot call an LLM, and cannot be reached
# from another machine on the network.
#
# If you find yourself adding a secret here to make something work, stop — that
# feature is not part of the demo, and the kit is safer without it.
# ---------------------------------------------------------------------------

# Everything resolves relative to this folder. Never point these at the
# production tree.
AUTOPILOT_DB_PATH=backend/data/autopilot.sqlite

PORT=4270

# LOCALHOST ONLY. The dashboard has no login (below), so binding all interfaces
# would serve it to anyone on the conference/hotel/client wifi. Do not change.
SERVER_HOST=127.0.0.1
AUTH_ENABLED=false

# No job worker, no backup scheduler, no permit/NEM monitor, no AHJ form refresh,
# no KB link check, no CEC sync. The local chain still runs when you click QC
# (split -> build docs -> reviewer gate): enqueuing a job starts it regardless of
# this flag, and every step of it is local — forms for these four AHJs are already
# on disk, and with no API key nothing calls an LLM.
BACKGROUND_WORKERS=off

# NEVER OPEN A PORTAL. Once the reviewer gate clears, "Stage portals" would
# otherwise launch a browser at the real AHJ/utility portal with no login. With
# this, staging runs every gate and then stops with a plain message. Refuse-only.
PORTAL_AUTOMATION=off

# Belt and braces for the same promise: never auto-start an autopilot run.
AUTOPILOT_AUTO_START=0

# NEVER DOWNLOAD. Without these, Run QC re-checks each AHJ's blank forms once a
# day and downloads any that are missing (e.g. Oregon BCD 5952) — and a download
# that meets a bot wall falls back to opening a visible browser. The four demo
# AHJs' forms are already on disk, so nothing is lost.
AHJ_FORM_DOWNLOADS=off
DOCUMENT_FETCH=off

# Belt and braces: no SMTP credentials exist here, but say it out loud anyway.
CLIENT_NOTIFICATIONS=false

# Safety rule 1 is enforced in code, not by this flag. It is here so that the
# answer to "could it submit?" is visible in the config, not just in the source.
PORTAL_ALLOW_FINAL_SUBMIT=false

LOG_LEVEL=info

# Unique to this kit, generated when it was built — NOT the production key.
# It encrypts portal credentials at rest, and this kit contains none, so it
# protects nothing. The server refuses to boot without one, so here it is.
SESSION_ENCRYPTION_KEY=GENERATE-A-NEW-ONE-PER-KIT
